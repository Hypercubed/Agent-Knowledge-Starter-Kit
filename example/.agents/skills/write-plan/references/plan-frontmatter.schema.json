{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Plan Frontmatter Schema",
  "description": "Schema for validating maintainer plan YAML frontmatter in .agents/docs/plans/*.md",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$",
      "description": "Stable slug, must match the filename without .md. Unique within plans/ and plans/archive/."
    },
    "title": {
      "type": "string",
      "description": "Short human title."
    },
    "last_updated": {
      "type": "string",
      "format": "date",
      "description": "ISO calendar date YYYY-MM-DD."
    },
    "description": {
      "type": "string",
      "description": "One or two sentences summarizing the entry."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_-]+$"
      },
      "minItems": 1,
      "description": "Non-empty list of lowercase [a-z0-9_-] labels."
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "paused", "completed", "cancelled", "superseded", "archived"],
      "description": "Plan lifecycle status."
    },
    "kind": {
      "type": "string",
      "enum": ["initiative", "meta", "exploration"],
      "default": "initiative",
      "description": "Type of plan."
    },
    "anticipated_decisions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^decisions/[a-z0-9_-]+$"
      },
      "description": "Planned decisions/<slug> pointers not yet filed."
    },
    "outcome_decisions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(decisions|troubleshooting)/[a-z0-9_-]+$"
      },
      "description": "Pointers to decisions or troubleshooting produced or materially updated."
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^plans/[a-z0-9_-]+$"
      },
      "description": "Pointers to plans replaced by this one."
    },
    "superseded_by": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^plans/[a-z0-9_-]+$"
      },
      "description": "Pointers to plans that replace this one."
    },
    "related_plans": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^plans/[a-z0-9_-]+$"
      },
      "description": "Other related plans/<slug> pointers."
    },
    "consumer_portable": {
      "type": "boolean",
      "description": "True if intended to ship in generated example/."
    },
    "author_kind": {
      "type": "string",
      "enum": ["human", "ai"],
      "description": "Provenance audit."
    },
    "prompter": {
      "type": "string",
      "description": "Free text prompter when author_kind is ai."
    }
  },
  "required": ["id", "title", "last_updated", "description", "tags", "status"],
  "additionalProperties": false
}